# Contact form — email delivery configuration
# The free diagnostic form submits to /api/contact.
# Without a provider configured below, submissions are SAFELY RECORDED LOCALLY
# (var/leads/diagnostic.jsonl) and reported as "recorded" — no email is sent.
# Configure ONE provider to enable real email delivery.

# Required for every provider:
CONTACT_EMAIL_FROM="Proodz <contact@proodz.com>"
# Recipient of the diagnostic notifications (defaults to contact@proodz.com):
CONTACT_EMAIL_TO="contact@proodz.com"

# Provider 1: Resend (recommended, simple HTTP API)
# https://resend.com
RESEND_API_KEY=""

# Provider 2: SendGrid
# https://sendgrid.com
# SENDGRID_API_KEY=""

# Provider 3: Mailgun
# https://www.mailgun.com
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN="mg.yourdomain.com"

# Optional: where the safe fallback writes leads
# (defaults to <project root>/var/leads)
# LEADS_DIR=""

# Analytics & search console — see docs/ANALYTICS.md for full setup and
# verification steps. Both are public (NEXT_PUBLIC_*) by design: a GA4
# measurement ID and a GSC verification token are meant to be visible in
# the page source — neither is a secret. Never put a GA4 API SECRET or
# any other private key in a NEXT_PUBLIC_* variable.

# Google Analytics 4 — Admin > Data Streams > Web > Measurement ID
# Format: G-XXXXXXXXXX. Leave empty to disable analytics entirely
# (no script loads, no cookie banner is shown).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console — Settings > Ownership verification > HTML tag
# method. Paste only the "content" value of the meta tag Google gives
# you, not the full <meta> tag.
NEXT_PUBLIC_GSC_VERIFICATION=""
