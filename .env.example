# Contact form — email delivery configuration
# The free diagnostic form submits to /api/contact.
# Without a provider configured below, submissions are SAFELY RECORDED LOCALLY
# (var/leads/diagnostic.jsonl) and reported as "recorded" — no email is sent.
# Configure ONE provider to enable real email delivery.

# Required for every provider:
CONTACT_EMAIL_FROM="Proodz <contact@proodz.com>"
# Recipient of the diagnostic notifications (defaults to contact@proodz.com):
CONTACT_EMAIL_TO="contact@proodz.com"

# Provider 1: Resend (recommended, simple HTTP API)
# https://resend.com
RESEND_API_KEY=""

# Provider 2: SendGrid
# https://sendgrid.com
# SENDGRID_API_KEY=""

# Provider 3: Mailgun
# https://www.mailgun.com
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN="mg.yourdomain.com"

# Optional: where the safe fallback writes leads
# (defaults to <project root>/var/leads)
# LEADS_DIR=""
